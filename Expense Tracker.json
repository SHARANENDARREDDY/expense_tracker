    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst raw = $json.text;\n\nconst cleaned = raw\n  .replace(/^```json\\s*/i, \"\")\n  .replace(/^```\\s*/i, \"\")\n  .replace(/\\s*```$/i, \"\")\n  .trim();\n\nconst expense = JSON.parse(cleaned);\n\nif (\n  expense.intent === \"add\" &&\n  (!Number.isFinite(expense.amount) || expense.amount <= 0)\n) {\n  throw new Error(\"Expense amount must be a positive number.\");\n}\n\nreturn {\n  json: {\n    ...expense,\n    chat_id: $(\"Edit Fields\").first().json.chat_id\n  }\n};\n"
      },
